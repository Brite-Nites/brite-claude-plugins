{
  "description": "Flow-architecture plugin hooks — SessionStart core-enablement nudge + SubagentStart brain-first preamble injection",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/../_shared/core-enablement-warning.sh\" flow-architecture 2>/dev/null || true",
            "timeout": 3,
            "statusMessage": "Checking brite-core enablement..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/../_shared/team-gbrain-usage.md\" 2>/dev/null || true",
            "timeout": 3,
            "statusMessage": "Loading brain-first guidance..."
          }
        ]
      }
    ]
  }
}
