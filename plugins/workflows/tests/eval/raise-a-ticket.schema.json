{
  "type": "object",
  "required": ["schema_version", "command", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "/workflows:raise-a-ticket" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "error", "kind", "type_label", "severity_label", "priority",
          "team", "team_tiebreak", "applied_labels", "missing_labels",
          "triage_state_fallback", "severity_carried_by_priority", "notes", "footer"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "error": { "type": ["string", "null"] },
          "kind": { "type": ["string", "null"] },
          "type_label": { "type": ["string", "null"], "enum": ["type:bug", "type:task", null] },
          "severity_label": { "type": ["string", "null"], "enum": ["severity:sev0", "severity:sev1", "severity:sev2", "severity:sev3", null] },
          "priority": { "type": ["integer", "null"], "enum": [1, 2, 3, 4, null] },
          "team": { "type": ["string", "null"] },
          "team_tiebreak": { "type": ["string", "null"], "enum": ["single", "modal", "tie-brite-company", "fallback-brite-company", null] },
          "applied_labels": { "type": "array", "items": { "type": "string" } },
          "missing_labels": { "type": "array", "items": { "type": "string" } },
          "triage_state_fallback": { "type": ["string", "null"], "enum": ["Triage", null] },
          "severity_carried_by_priority": { "type": "boolean" },
          "notes": { "type": "array", "items": { "type": "string" } },
          "footer": { "type": ["string", "null"] }
        }
      }
    }
  }
}
