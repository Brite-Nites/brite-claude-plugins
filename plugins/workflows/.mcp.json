{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@2025.12.18"]
    },
    "linear-server": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "gbrain-team": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/gbrain-team-broker.sh",
      "args": [
        "https://brite-team-gbrain-serve-production.up.railway.app/mcp"
      ]
    },
    "gbrain-team-write": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/gbrain-team-broker.sh",
      "args": [
        "--write",
        "https://brite-team-gbrain-serve-production.up.railway.app/mcp"
      ]
    }
  }
}
