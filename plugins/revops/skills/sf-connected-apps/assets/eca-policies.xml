<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template: External Client App - Configurable Policies
  Use Case: App-level enablement and landing page for the ECA

  THIS TYPE CARRIES NO OAUTH POLICY. IP relaxation, refresh-token lifetime,
  permitted users, and session level live on the near-identically-named
  ExtlClntAppOauthConfigurablePolicies — see assets/eca-oauth-policies.xml.
  Confusing the two is the easiest mistake to make here and produces a file
  that will not deploy.

  Field list verified against a live retrieve from brite-dev-kells (2026-07-28).

  Note: these records are created when OAuth is enabled on the app, not when the
  app is created. A retrieve that runs before then comes back empty — that is
  "does not exist yet", NOT "cannot be captured". See SKILL.md § An empty
  metadata retrieve is not evidence of a platform limitation.

  Replace placeholders:
  - {{APP_NAME}}: The ExternalClientApplication API name (must match .eca file)
  - {{LABEL}}: Display label for this policy configuration
  - {{IS_ENABLED}}: true | false — whether the app is enabled in this org
  - {{IS_OAUTH_PLUGIN_ENABLED}}: true | false — whether the OAuth plugin is active
  - {{START_PAGE}}: landing URL after login; omit the element entirely if unused

  File Naming: [AppName].ecaPlcy-meta.xml
-->
<ExtlClntAppConfigurablePolicies xmlns="http://soap.sforce.com/2006/04/metadata">
    <externalClientApplication>{{APP_NAME}}</externalClientApplication>
    <isEnabled>{{IS_ENABLED}}</isEnabled>
    <isOauthPluginEnabled>{{IS_OAUTH_PLUGIN_ENABLED}}</isOauthPluginEnabled>
    <label>{{LABEL}}</label>
    <startPage>{{START_PAGE}}</startPage>
</ExtlClntAppConfigurablePolicies>
