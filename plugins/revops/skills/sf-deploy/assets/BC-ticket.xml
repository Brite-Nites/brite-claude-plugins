<?xml version="1.0" encoding="UTF-8"?>
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
    Brite ticket-scoped destructive-manifest template.

    Copy this shape to the brite-salesforce repository as:
      manifest/destructive/BC-<ticket>.xml

    Never name it manifest/destructiveChanges.xml,
    manifest/preDestructiveChanges.xml, or either config/ equivalent.
    hardis auto-executes those filenames in ordinary deploy lanes.

    One reviewed ticket per file. Enumerate every member; no wildcards.
    Merging the manifest is additive and does not execute it. A release
    manager runs .github/workflows/destructive-deploy.yml validate-only
    first, then follows the gated ceremony in:
      docs/runbooks/destructive-deploy-ceremony.md
    -->

    <types>
        <members>Replace_With_Reviewed_Component_Name</members>
        <name>Replace_With_Metadata_Type</name>
    </types>

    <version>65.0</version>
</Package>
