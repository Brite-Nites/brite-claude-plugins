{
  "description": "RevOps plugin hooks — cwd-aware SessionStart banner when an SFDX project is reachable from the user's pwd + SessionStart core-enablement nudge",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sfdx-banner.sh\"",
            "timeout": 3,
            "statusMessage": "Probing for SFDX project..."
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/../_shared/core-enablement-warning.sh\" revops",
            "timeout": 3,
            "statusMessage": "Checking brite-core enablement..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/../_shared/team-gbrain-usage.md\" 2>/dev/null || true",
            "timeout": 3,
            "statusMessage": "Loading brain-first guidance..."
          }
        ]
      }
    ]
  }
}
