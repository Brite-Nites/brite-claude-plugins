{
  "mcpServers": {
    "salesforce": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@salesforce/mcp@0.30.5",
        "--orgs",
        "DEFAULT_TARGET_ORG",
        "--toolsets",
        "data",
        "--no-telemetry"
      ]
    },
    "spider": {
      "type": "stdio",
      "command": "bws",
      "args": [
        "run",
        "--project-id",
        "TAM-MAP-PROJECT-ID-PENDING",
        "--",
        "exec npx -y spider-cloud-mcp@2.1.1"
      ]
    },
    "aiark": {
      "type": "stdio",
      "command": "bws",
      "args": [
        "run",
        "--project-id",
        "TAM-MAP-PROJECT-ID-PENDING",
        "--",
        "exec node '${CLAUDE_PLUGIN_ROOT}/scripts/tam-map/aiark-mcp.js'"
      ]
    },
    "discolike": {
      "type": "stdio",
      "command": "bws",
      "args": [
        "run",
        "--project-id",
        "TAM-MAP-PROJECT-ID-PENDING",
        "--",
        "exec node '${CLAUDE_PLUGIN_ROOT}/scripts/tam-map/discolike-mcp.js'"
      ]
    },
    "gbrain-team": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/gbrain-team-broker.sh",
      "args": [
        "https://brite-team-gbrain-serve-production.up.railway.app/mcp"
      ]
    },
    "enrichment": {
      "type": "stdio",
      "command": "bws",
      "args": [
        "run",
        "--project-id",
        "ENRICHMENT-PROJECT-ID-PENDING",
        "--",
        "exec uvx --from 'git+https://github.com/Brite-Nites/brite-data-platform@0ac5389cc198a29a7f68c710f0814cf645c31666#subdirectory=tools/enrichment-mcp' brite-enrichment-mcp"
      ],
      "env": {
        "USE_MOCK_PROVIDERS": "False",
        "MARTS_DATABASE": "ANALYTICS",
        "MARTS_SCHEMA": "MARTS",
        "ENRICHMENT_API_URL": "https://brite-data-platform-production.up.railway.app"
      }
    }
  }
}
