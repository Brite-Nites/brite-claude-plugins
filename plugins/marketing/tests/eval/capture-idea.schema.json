{
  "type": "object",
  "required": ["schema_version", "command", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "/marketing:capture-idea" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "error", "status", "missing_for_completeness",
          "match_state", "label_name", "save_issue_payload"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "error": { "type": ["string", "null"] },
          "status": { "type": ["string", "null"], "enum": ["Sketch", "Maturing", null] },
          "missing_for_completeness": {
            "type": ["array", "null"],
            "items": { "type": "string", "enum": ["brand fit", "source", "ICP", "commercial model"] }
          },
          "match_state": { "type": ["string", "null"], "enum": ["no", "vertical-only", "full", null] },
          "label_name": { "type": ["string", "null"], "enum": ["status:sketch", "status:maturing", null] },
          "save_issue_payload": {
            "type": ["object", "null"],
            "required": ["title", "team", "project", "milestone", "description", "state", "priority", "labels"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": ["string", "null"] },
              "team": { "const": "Brite Company" },
              "project": { "const": "Brite GTM" },
              "milestone": { "type": ["string", "null"] },
              "description": { "type": "string" },
              "state": { "const": "Backlog" },
              "priority": { "const": 0 },
              "labels": {
                "type": "array",
                "items": { "type": "string", "enum": ["status:sketch", "status:maturing"] }
              }
            }
          }
        }
      }
    }
  }
}
