# Audit artifacts
AUDIT.md
# Negation: case-insensitive filesystems (macOS APFS default) match the rule
# above against `audit.md` too — keep the FDA-plugin audit command tracked.
!plugins/flow-architecture/commands/audit.md

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json

# Repo-root MCP config — dev-scoped, may contain real credentials.
# Plugin .mcp.json files (plugins/*/.mcp.json) are NOT ignored — they ship with
# the plugin and must use ${ENV_VAR} substitution for any credentials.
/.mcp.json

# Behavioral test results (generated, uploaded as CI artifacts)
tests/evals/behavioral-*.json

# Local-only provisioning artifacts (certs, keys, consumer keys, etc.)
# Never committed — secrets live in Bitwarden, this is just a workspace
.local/

# Python bytecode from scripts/_lib/ linters (lint_hooks.py, lint_cadence_gates.py, …)
__pycache__/
*.pyc

# Node dependencies — tam-map ships package.json + lockfile; deps install locally.
**/node_modules/

# Worktree mountpoints created by /workflows:session-start (per-session, never committed).
.claude/worktrees/
